      editBudget:e=>this.setState({budget:e.target.value}),
      editOccasion:e=>this.setState({occasion:e.target.value}),
      recommend:()=>{ this.setState({tab:'rec',rec:'thinking'}); setTimeout(()=>this.setState({rec:'done'}),1600); },
      goScan:()=>this.setState({tab:'scan'}),
      recEmpty:s.rec==='empty', recThinking:s.rec==='thinking', recDone:s.rec==='done', recs:recList,
      tasteChips:(TASTE[prof]||[]).slice(0,3).map(t=>({label:t.label.split(' · ')[0].toUpperCase(),score:t.score})),
      tasteRows:TASTE[prof]||[],
      settingRows:[{label:'Anthropic API key',value:'sk-ant-••••4f2a'},{label:'Model',value:'SONNET-4-6'},{label:'Export backup',value:s.entries.length+' ENTRIES'},{label:'Import backup',value:'MERGE'}],
      sbUrl:s.sbUrl, sbKey:s.sbKey, sbMsg:s.sbMsg,
      sbStatus:{local:'LOCAL ONLY',connecting:'CONNECTING…',connected:'SUPABASE · LIVE',error:'NOT CONNECTED'}[s.sbState],
      sbColor:{local:'rgba(251,243,231,0.45)',connecting:GOLD,connected:'#8FD69A',error:'#F09274'}[s.sbState],
      sbAction:s.sbState==='connected'?'RECONNECT':'CONNECT',
      editSbUrl:e=>this.setState({sbUrl:e.target.value}),
      editSbKey:e=>this.setState({sbKey:e.target.value}),
      connectSb:()=>{ if(!s.sbUrl||!s.sbKey){ this.setState({sbState:'error',sbMsg:'Paste the project URL and the anon public key first.'}); return; } this.doConnect(s.sbUrl.trim(),s.sbKey.trim()); },
      pushSb:async()=>{ if(s.sbState!=='connected'){ this.setState({sbMsg:'Connect first, then push.'}); return; }
        try{ const st=await this.store(); const n=await st.pushLocal(s.entries); const rows=await st.fetchEntries();
          this.setState({entries:rows,sbMsg:n?n+' entries pushed to Supabase.':'Nothing local left to push.'}); }
        catch(err){ this.setState({sbMsg:(err&&err.message)||'Push failed.'}); } },
      openLog:e=>{ const i=+e.currentTarget.dataset.i, r=recList[i];
        this.setState({log:r.name,rating:4,logUser:prof,logPrice:(r.price||'').replace(/[^0-9]/g,''),logServing:'Bottle',logNotes:'',logPlace:s.occasion||''}); },
      logUserTabs:['Lisa','Marios','Both'].map(v=>({v,label:v.toUpperCase(),style:this.monoStyle((s.logUser||prof)===v)})),
      setLogUser:e=>this.setState({logUser:e.currentTarget.dataset.v}),
      saveWish:e=>{ const i=+e.currentTarget.dataset.i, r=recList[i], w=s.wines[(RECS[prof][i]||{}).i]||{};
        const item={id:'w'+Date.now(),user:prof,date:new Date().toISOString().slice(0,10),wineName:r.name,producer:w.producer,vintage:w.vintage,grape:w.grape,region:w.region,rating:null,notes:'',restaurant:'',notedFrom:s.occasion||'Seen on a list'};
        const next=[item,...s.entries]; this.setState({entries:next}); this.persist(next);
        this.writeEntry(item).then(saved=>{ if(saved&&saved.id!==item.id) this.setState(p=>({entries:p.entries.map(x=>x.id===item.id?saved:x)})); });
        this.flash('SAVED TO '+(prof==='Both'?'OUR':prof.toUpperCase()+'\u2019S')+' WANT-TO-TRY'); },
      logOpen:!!s.log, logName:s.log, closeLog:()=>this.setState({log:null}),
      dialStops:[1,2,3,4,5].map(v=>({v})), sunPct:((s.rating-1)/4*100)+'%', ratingWord:WORDS[s.rating],
      setRating:e=>this.setState({rating:+e.currentTarget.dataset.v}),
      logPrice:s.logPrice, logCurrency:s.logCurrency, logServing:s.logServing, logServingUpper:s.logServing.toUpperCase(),
      logNotes:s.logNotes, logPlace:s.logPlace, saveLabel:'ADD TO '+((s.logUser||prof)==='Both'?'OUR':(s.logUser||prof).toUpperCase()+'\u2019S')+' HISTORY',
      editLogPrice:e=>this.setState({logPrice:e.target.value}),
      editLogPlace:e=>this.setState({logPlace:e.target.value}),
      editLogNotes:e=>this.setState({logNotes:e.target.value}),
      cycleCurrency:()=>this.setState(p=>({logCurrency:{'€':'$','$':'£','£':'€'}[p.logCurrency]})),
      cycleServing:()=>this.setState(p=>({logServing:p.logServing==='Bottle'?'Glass':'Bottle'})),
      saveLog:()=>{ const w=s.wines.find(x=>x.name===s.log)||{}, u=s.logUser||prof;
        const item={id:String(Date.now()),user:u,date:new Date().toISOString().slice(0,10),wineName:s.log,producer:w.producer,vintage:w.vintage,grape:w.grape,region:w.region,serving:s.logServing,price:+s.logPrice||0,currency:s.logCurrency,rating:s.rating,notes:s.logNotes,restaurant:s.logPlace};
        const next=[item,...s.entries];
        this.setState({entries:next,log:null,tab:'journal',kind:'Logged'}); this.persist(next);
        this.writeEntry(item).then(saved=>{ if(saved&&saved.id!==item.id) this.setState(p=>({entries:p.entries.map(x=>x.id===item.id?saved:x)})); });
        this.flash('LOGGED \u2014 '+WORDS[s.rating].toUpperCase()); },
      entries:ent, journalEmpty:ent.length===0,
      viewTimeline:s.view==='timeline'&&ent.length>0, viewList:s.view==='list'&&ent.length>0, viewGallery:s.view==='gallery'&&ent.length>0,
      kindTabs:['Logged','Want to try'].map(v=>({v,label:v.toUpperCase(),style:this.monoStyle(s.kind===v)})),
      viewTabs:[['timeline','Timeline'],['list','List'],['gallery','Gallery']].map(([v,label])=>({v,label,style:this.viewStyle(s.view===v)})),
      setKind:e=>this.setState({kind:e.currentTarget.dataset.v}),
      setView:e=>this.setState({view:e.currentTarget.dataset.v}),
      search:s.search, editSearch:e=>this.setState({search:e.target.value}),
      tabs:[['scan','SCAN'],['rec','TONIGHT'],['journal','HISTORY'],['profile','US']].map(([v,label])=>({v,label,style:this.tabStyle(s.tab===v)})),
      setTab:e=>this.setState({tab:e.currentTarget.dataset.v}),
      toast:s.toast
    };
  }
}
</script>
</body>
