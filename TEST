<!DOCTYPE html>
<html>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<script src="./support.js"></script>
</head>
<body>
<x-dc>
<helmet>
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300..800;1,9..144,300..800&family=Public+Sans:ital,wght@0,300..800;1,300..700&family=IBM+Plex+Mono:wght@400;500&display=swap">
<style>
body{margin:0;background:#0B0A18;display:flex;align-items:center;justify-content:center;min-height:100vh;font-family:'Public Sans',system-ui,sans-serif}
*{box-sizing:border-box}
input,textarea,button{font-family:inherit}
input::placeholder,textarea::placeholder{color:rgba(251,243,231,0.3)}
a{color:#F2B85C}
a:hover{color:#E4623F}
::-webkit-scrollbar{width:0}
@keyframes eosPulse{0%,100%{opacity:.35}50%{opacity:.9}}
@keyframes eosRise{from{opacity:0;transform:translateY(12px)}to{opacity:1;transform:none}}
</style>
</helmet>
<x-import component-from-global-scope="IOSDevice" from="./ios-frame.jsx" dark="{{ true }}" hint-size="402px,874px">

<div style="position:absolute;inset:0;background:#14132B"></div>
<div style="position:absolute;inset:0;display:flex;flex-direction:column">

<div style="flex:none;padding:58px 26px 18px;border-bottom:1px solid rgba(251,243,231,0.14)">
<div style="display:flex;align-items:baseline;justify-content:space-between;gap:12px">
<div style="font-family:'Fraunces',serif;font-weight:300;font-size:33px;color:#FBF3E7;letter-spacing:-0.8px;line-height:1">{{ screenTitle }}</div>
<div style="display:flex;gap:7px;align-items:baseline">
<sc-for list="{{ profileTabs }}" as="p" hint-placeholder-count="3">
<button data-v="{{ p.v }}" onClick="{{ setProfile }}" style="{{ p.style }}">{{ p.label }}</button>
</sc-for>
</div>
</div>
<div style="font-family:'IBM Plex Mono',monospace;font-size:10.5px;letter-spacing:1.4px;text-transform:uppercase;color:rgba(242,184,92,0.8);margin-top:9px">{{ screenNote }}</div>
</div>

<div style="flex:1;overflow-y:auto;overflow-x:hidden;padding:0 26px 120px">

<sc-if value="{{ isScan }}" hint-placeholder-val="{{ true }}">
<div style="display:flex;flex-direction:column">

<sc-if value="{{ scanIdle }}" hint-placeholder-val="{{ true }}">
<div style="display:flex;flex-direction:column;gap:22px;padding-top:22px">
<div style="font-family:'Fraunces',serif;font-weight:300;font-size:25px;line-height:1.3;color:#FBF3E7;letter-spacing:-0.4px;text-wrap:pretty">Point at the wine list.<br><span style="font-style:italic;color:#F2B85C">Eos has your back.</span></div>
<div style="position:relative;height:320px;border:1px solid rgba(251,243,231,0.14)">
<div style="position:absolute;inset:0;display:flex;flex-direction:column;justify-content:center;gap:11px;padding:38px 30px;opacity:.4">
<div style="height:1px;width:64%;background:rgba(251,243,231,0.7)"></div>
<div style="height:1px;width:38%;background:rgba(251,243,231,0.3)"></div>
<div style="height:1px;width:76%;background:rgba(251,243,231,0.7);margin-top:18px"></div>
<div style="height:1px;width:32%;background:rgba(251,243,231,0.3)"></div>
<div style="height:1px;width:58%;background:rgba(251,243,231,0.7);margin-top:18px"></div>
<div style="height:1px;width:46%;background:rgba(251,243,231,0.3)"></div>
</div>
<div style="position:absolute;top:18px;left:18px;width:26px;height:26px;border-top:1px solid #F2B85C;border-left:1px solid #F2B85C"></div>
<div style="position:absolute;top:18px;right:18px;width:26px;height:26px;border-top:1px solid #F2B85C;border-right:1px solid #F2B85C"></div>
<div style="position:absolute;bottom:18px;left:18px;width:26px;height:26px;border-bottom:1px solid #F2B85C;border-left:1px solid #F2B85C"></div>
<div style="position:absolute;bottom:18px;right:18px;width:26px;height:26px;border-bottom:1px solid #F2B85C;border-right:1px solid #F2B85C"></div>
<div style="position:absolute;left:0;right:0;top:50%;height:1px;background:linear-gradient(90deg,transparent,rgba(242,184,92,0.8),transparent);animation:eosPulse 2.6s ease-in-out infinite"></div>
</div>
<button onClick="{{ capture }}" style="height:52px;border:1px solid #F2B85C;background:transparent;color:#F2B85C;font-family:'IBM Plex Mono',monospace;font-size:12px;letter-spacing:2.4px;cursor:pointer">CAPTURE</button>
<div style="font-size:12.5px;line-height:1.55;color:rgba(251,243,231,0.5);max-width:280px">Shoot as many pages as the list runs to — they merge into one parsed list.</div>
</div>
</sc-if>

<sc-if value="{{ scanCaptured }}" hint-placeholder-val="{{ true }}">
<div style="display:flex;flex-direction:column;gap:20px;padding-top:24px;animation:eosRise .3s cubic-bezier(0.22,1,0.36,1)">
<div style="font-family:'Fraunces',serif;font-weight:300;font-size:24px;color:#FBF3E7;letter-spacing:-0.4px">{{ photoCount }} page{{ photoPlural }} captured</div>
<div style="display:flex;gap:12px;flex-wrap:wrap">
<sc-for list="{{ photos }}" as="p" hint-placeholder-count="2">
<div style="width:82px;height:106px;border:1px solid rgba(242,184,92,0.4);display:flex;align-items:flex-end;padding:7px;font-family:'IBM Plex Mono',monospace;font-size:10px;letter-spacing:1px;color:rgba(242,184,92,0.85)">{{ p.label }}</div>
</sc-for>
<button onClick="{{ addPhoto }}" style="width:82px;height:106px;background:transparent;border:1px dashed rgba(251,243,231,0.28);color:rgba(251,243,231,0.5);font-family:'IBM Plex Mono',monospace;font-size:11px;letter-spacing:1px;cursor:pointer">+ PAGE</button>
</div>
<button onClick="{{ parseMenu }}" style="height:52px;border:none;background:#F2B85C;color:#14132B;font-family:'IBM Plex Mono',monospace;font-size:12px;letter-spacing:2.4px;cursor:pointer">READ THIS LIST</button>
<button onClick="{{ reset }}" style="height:34px;border:none;background:transparent;color:rgba(251,243,231,0.45);font-family:'IBM Plex Mono',monospace;font-size:11px;letter-spacing:1.4px;cursor:pointer">START OVER</button>
</div>
</sc-if>

<sc-if value="{{ scanParsing }}" hint-placeholder-val="{{ true }}">
<div style="padding-top:70px;display:flex;flex-direction:column;gap:16px">
<div style="width:100%;height:1px;background:linear-gradient(90deg,#F2B85C,transparent);animation:eosPulse 1.4s ease-in-out infinite"></div>
<div style="font-family:'Fraunces',serif;font-weight:300;font-size:23px;color:#FBF3E7;letter-spacing:-0.4px">Reading the list</div>
<div style="font-family:'IBM Plex Mono',monospace;font-size:11px;letter-spacing:1.4px;color:rgba(251,243,231,0.45)">PRODUCERS · VINTAGES · GRAPES · PRICES</div>
</div>
</sc-if>

<sc-if value="{{ scanError }}" hint-placeholder-val="{{ true }}">
<div style="margin-top:26px;border-left:2px solid #E4623F;padding:4px 0 4px 16px;display:flex;flex-direction:column;gap:12px">
<div style="font-size:13.5px;line-height:1.5;color:#FBF3E7">The read failed halfway through page 2. Nothing was lost.</div>
<button onClick="{{ parseMenu }}" style="align-self:flex-start;height:36px;padding:0 16px;border:1px solid #E4623F;background:transparent;color:#F2B85C;font-family:'IBM Plex Mono',monospace;font-size:11px;letter-spacing:1.6px;cursor:pointer">RETRY</button>
</div>
</sc-if>

<sc-if value="{{ scanParsed }}" hint-placeholder-val="{{ true }}">
<div style="display:flex;flex-direction:column;animation:eosRise .35s cubic-bezier(0.22,1,0.36,1)">
<div style="display:flex;align-items:baseline;justify-content:space-between;padding:20px 0 12px;border-bottom:1px solid rgba(251,243,231,0.14)">
<div style="font-family:'Fraunces',serif;font-weight:300;font-size:24px;color:#FBF3E7;letter-spacing:-0.4px">{{ wineCount }} wines found</div>
<div style="font-family:'IBM Plex Mono',monospace;font-size:10px;letter-spacing:1.2px;color:rgba(251,243,231,0.4)">TAP TO FIX</div>
</div>
<sc-for list="{{ wines }}" as="w" hint-placeholder-count="4">
<div style="padding:16px 0;border-bottom:1px solid rgba(251,243,231,0.1);display:flex;flex-direction:column;gap:9px">
<div style="display:flex;gap:12px;align-items:baseline">
<input value="{{ w.name }}" data-i="{{ $index }}" data-f="name" onChange="{{ editWine }}" style="flex:1;min-width:0;background:transparent;border:none;outline:none;font-family:'Fraunces',serif;font-weight:400;font-size:20px;letter-spacing:-0.4px;color:#FBF3E7;padding:0">
<input value="{{ w.price }}" data-i="{{ $index }}" data-f="price" onChange="{{ editWine }}" style="width:60px;background:transparent;border:none;outline:none;text-align:right;font-family:'IBM Plex Mono',monospace;font-size:13px;color:#F2B85C;padding:0">
</div>
<div style="display:flex;gap:10px;align-items:center">
<input value="{{ w.producer }}" data-i="{{ $index }}" data-f="producer" onChange="{{ editWine }}" style="flex:1.5;min-width:0;background:transparent;border:none;border-bottom:1px solid rgba(251,243,231,0.12);outline:none;font-size:12px;color:rgba(251,243,231,0.62);padding:3px 0">
<input value="{{ w.vintage }}" data-i="{{ $index }}" data-f="vintage" onChange="{{ editWine }}" style="width:44px;background:transparent;border:none;border-bottom:1px solid rgba(251,243,231,0.12);outline:none;font-family:'IBM Plex Mono',monospace;font-size:12px;color:rgba(251,243,231,0.62);padding:3px 0">
<button data-i="{{ $index }}" onClick="{{ toggleServing }}" style="flex:none;background:transparent;border:none;border-bottom:1px solid rgba(242,184,92,0.4);color:#F2B85C;font-family:'IBM Plex Mono',monospace;font-size:11px;letter-spacing:1.2px;padding:3px 2px;cursor:pointer">{{ w.servingShort }}</button>
</div>
<div style="display:flex;gap:10px">
<input value="{{ w.grape }}" data-i="{{ $index }}" data-f="grape" onChange="{{ editWine }}" style="flex:1;min-width:0;background:transparent;border:none;border-bottom:1px solid rgba(251,243,231,0.12);outline:none;font-size:12px;color:rgba(251,243,231,0.62);padding:3px 0">
<input value="{{ w.region }}" data-i="{{ $index }}" data-f="region" onChange="{{ editWine }}" style="flex:1;min-width:0;background:transparent;border:none;border-bottom:1px solid rgba(251,243,231,0.12);outline:none;font-size:12px;color:rgba(251,243,231,0.62);padding:3px 0">
</div>
</div>
</sc-for>
<div style="display:flex;gap:18px;padding:18px 0 22px;border-bottom:1px solid rgba(251,243,231,0.14)">
<input value="{{ budget }}" onChange="{{ editBudget }}" placeholder="Budget" style="flex:1;min-width:0;background:transparent;border:none;border-bottom:1px solid rgba(251,243,231,0.2);outline:none;font-size:13px;color:#FBF3E7;padding:6px 0">
<input value="{{ occasion }}" onChange="{{ editOccasion }}" placeholder="Occasion" style="flex:1;min-width:0;background:transparent;border:none;border-bottom:1px solid rgba(251,243,231,0.2);outline:none;font-size:13px;color:#FBF3E7;padding:6px 0">
</div>
<button onClick="{{ recommend }}" style="margin-top:22px;height:54px;border:none;background:#F2B85C;color:#14132B;font-family:'IBM Plex Mono',monospace;font-size:12px;letter-spacing:2.4px;cursor:pointer">FIND OUR PICK</button>
</div>
</sc-if>

</div>
</sc-if>

<sc-if value="{{ isRec }}" hint-placeholder-val="{{ true }}">
<div style="display:flex;flex-direction:column">

<sc-if value="{{ recEmpty }}" hint-placeholder-val="{{ true }}">
<div style="padding-top:60px;display:flex;flex-direction:column;gap:14px;align-items:flex-start">
<div style="font-family:'Fraunces',serif;font-weight:300;font-size:25px;line-height:1.3;color:#FBF3E7;letter-spacing:-0.4px">Nothing on the table yet</div>
<div style="font-size:13px;line-height:1.55;color:rgba(251,243,231,0.5);max-width:270px">Scan a wine list and we pick from what is actually available tonight.</div>
<button onClick="{{ goScan }}" style="margin-top:10px;height:44px;padding:0 20px;border:1px solid rgba(242,184,92,0.5);background:transparent;color:#F2B85C;font-family:'IBM Plex Mono',monospace;font-size:11px;letter-spacing:1.8px;cursor:pointer">GO TO SCAN</button>
</div>
</sc-if>

<sc-if value="{{ recThinking }}" hint-placeholder-val="{{ true }}">
<div style="padding-top:60px;display:flex;flex-direction:column;gap:16px">
<div style="width:100%;height:1px;background:linear-gradient(90deg,#F2B85C,transparent);animation:eosPulse 1.3s ease-in-out infinite"></div>
<div style="font-family:'Fraunces',serif;font-weight:300;font-size:23px;line-height:1.3;color:#FBF3E7;letter-spacing:-0.4px">Weighing {{ wineCount }} wines against {{ profilePoss }} palate</div>
</div>
</sc-if>

<sc-if value="{{ recDone }}" hint-placeholder-val="{{ true }}">
<div style="display:flex;flex-direction:column;animation:eosRise .35s cubic-bezier(0.22,1,0.36,1)">
<div style="display:flex;flex-wrap:wrap;gap:6px 14px;padding:16px 0;border-bottom:1px solid rgba(251,243,231,0.14);font-family:'IBM Plex Mono',monospace;font-size:10.5px;letter-spacing:1.1px;color:rgba(251,243,231,0.5)">
<sc-for list="{{ tasteChips }}" as="c" hint-placeholder-count="3">
<div>{{ c.label }} <span style="color:#F2B85C">{{ c.score }}</span></div>
</sc-for>
</div>
<sc-for list="{{ recs }}" as="r" hint-placeholder-count="3">
<div style="padding:22px 0;border-bottom:1px solid rgba(251,243,231,0.1);display:flex;flex-direction:column;gap:11px">
<div style="display:flex;align-items:baseline;justify-content:space-between;gap:10px">
<div style="font-family:'IBM Plex Mono',monospace;font-size:10px;letter-spacing:1.6px;color:{{ r.badgeFg }}">{{ r.matchUpper }}</div>
<div style="font-family:'IBM Plex Mono',monospace;font-size:13px;color:#F2B85C">{{ r.price }}</div>
</div>
<div>
<div style="font-family:'Fraunces',serif;font-weight:400;font-size:26px;line-height:1.15;color:#FBF3E7;letter-spacing:-0.6px">{{ r.name }}</div>
<div style="font-size:12px;color:rgba(251,243,231,0.5);margin-top:6px">{{ r.sub }}</div>
</div>
<div style="font-size:13.5px;line-height:1.6;color:rgba(251,243,231,0.8);text-wrap:pretty">{{ r.reason }}</div>
<div style="display:flex;gap:10px;margin-top:4px">
<button data-i="{{ $index }}" onClick="{{ openLog }}" style="flex:1;height:44px;border:none;background:#FBF3E7;color:#14132B;font-family:'IBM Plex Mono',monospace;font-size:11px;letter-spacing:1.6px;cursor:pointer">WE CHOSE THIS</button>
<button data-i="{{ $index }}" onClick="{{ saveWish }}" style="flex:none;height:44px;padding:0 16px;border:1px solid rgba(251,243,231,0.28);background:transparent;color:rgba(251,243,231,0.8);font-family:'IBM Plex Mono',monospace;font-size:11px;letter-spacing:1.4px;cursor:pointer">WANT TO TRY</button>
</div>
</div>
</sc-for>
<button onClick="{{ recommend }}" style="margin-top:20px;height:42px;border:1px solid rgba(251,243,231,0.2);background:transparent;color:rgba(251,243,231,0.65);font-family:'IBM Plex Mono',monospace;font-size:11px;letter-spacing:1.6px;cursor:pointer">SHOW ME THREE OTHERS</button>
</div>
</sc-if>

</div>
</sc-if>

<sc-if value="{{ isJournal }}" hint-placeholder-val="{{ true }}">
<div style="display:flex;flex-direction:column">

<div style="display:flex;gap:22px;padding:16px 0 0">
<sc-for list="{{ viewTabs }}" as="t" hint-placeholder-count="3">
<button data-v="{{ t.v }}" onClick="{{ setView }}" style="{{ t.style }}">{{ t.label }}</button>
</sc-for>
</div>
<div style="display:flex;align-items:center;justify-content:space-between;gap:12px;padding:16px 0;border-top:1px solid rgba(251,243,231,0.14);border-bottom:1px solid rgba(251,243,231,0.14);margin-top:14px">
<input value="{{ search }}" onChange="{{ editSearch }}" placeholder="Grape, region, producer, place" style="flex:1;min-width:0;background:transparent;border:none;outline:none;font-size:12.5px;color:#FBF3E7;padding:0">
<div style="display:flex;gap:12px">
<sc-for list="{{ kindTabs }}" as="t" hint-placeholder-count="2">
<button data-v="{{ t.v }}" onClick="{{ setKind }}" style="{{ t.style }}">{{ t.label }}</button>
</sc-for>
</div>
</div>

<sc-if value="{{ journalEmpty }}" hint-placeholder-val="{{ true }}">
<div style="padding:44px 0;font-family:'IBM Plex Mono',monospace;font-size:11px;letter-spacing:1.4px;color:rgba(251,243,231,0.35)">NOTHING MATCHES THAT YET</div>
</sc-if>

<sc-if value="{{ viewTimeline }}" hint-placeholder-val="{{ true }}">
<div style="display:flex;flex-direction:column">
<sc-for list="{{ entries }}" as="e" hint-placeholder-count="4">
<div style="display:flex;gap:18px;padding:22px 0;border-bottom:1px solid rgba(251,243,231,0.1)">
<div style="flex:none;width:52px;font-family:'IBM Plex Mono',monospace;font-size:11px;line-height:1.5;white-space:pre-line;color:rgba(242,184,92,0.75)">{{ e.dateStack }}</div>
<div style="flex:1;min-width:0">
<div style="font-family:'Fraunces',serif;font-weight:400;font-size:23px;line-height:1.15;color:#FBF3E7;letter-spacing:-0.5px">{{ e.wineName }}</div>
<div style="font-size:12px;color:rgba(251,243,231,0.5);margin-top:6px">{{ e.sub }}</div>
<div style="font-size:13px;line-height:1.55;color:rgba(251,243,231,0.76);margin-top:9px;font-style:italic;text-wrap:pretty">{{ e.notes }}</div>
<div style="display:flex;align-items:center;gap:10px;margin-top:12px">
<div style="position:relative;width:130px;height:2px;background:rgba(251,243,231,0.14)">
<div style="position:absolute;left:0;top:0;height:2px;background:linear-gradient(90deg,#7A2438,#E4623F,#F2B85C);width:{{ e.sunPct }}"></div>
</div>
<div style="font-family:'IBM Plex Mono',monospace;font-size:11px;color:{{ e.scoreColor }}">{{ e.scoreLabel }}</div>
<div style="flex:1"></div>
<div style="font-family:'IBM Plex Mono',monospace;font-size:10px;letter-spacing:1.2px;color:rgba(251,243,231,0.35)">{{ e.whoUpper }}</div>
</div>
</div>
</div>
</sc-for>
</div>
</sc-if>

<sc-if value="{{ viewList }}" hint-placeholder-val="{{ true }}">
<div style="display:flex;flex-direction:column">
<sc-for list="{{ entries }}" as="e" hint-placeholder-count="5">
<div style="padding:15px 0;border-bottom:1px solid rgba(251,243,231,0.1);display:flex;align-items:baseline;gap:12px">
<div style="flex:1;min-width:0">
<div style="font-family:'Fraunces',serif;font-weight:400;font-size:18px;color:#FBF3E7;letter-spacing:-0.3px">{{ e.wineName }}</div>
<div style="font-family:'IBM Plex Mono',monospace;font-size:10.5px;letter-spacing:0.8px;color:rgba(251,243,231,0.45);margin-top:5px">{{ e.subUpper }}</div>
</div>
<div style="flex:none;display:flex;align-items:center;gap:9px">
<div style="position:relative;width:52px;height:2px;background:rgba(251,243,231,0.14)"><div style="position:absolute;left:0;top:0;height:2px;background:linear-gradient(90deg,#7A2438,#F2B85C);width:{{ e.sunPct }}"></div></div>
<div style="font-family:'IBM Plex Mono',monospace;font-size:11px;color:{{ e.scoreColor }};width:26px;text-align:right">{{ e.scoreLabel }}</div>
</div>
</div>
</sc-for>
</div>
</sc-if>

<sc-if value="{{ viewGallery }}" hint-placeholder-val="{{ true }}">
<div style="display:grid;grid-template-columns:1fr 1fr;gap:1px;background:transparent;margin-top:18px">
<sc-for list="{{ entries }}" as="e" hint-placeholder-count="4">
<div style="aspect-ratio:0.82;padding:15px;display:flex;flex-direction:column;justify-content:space-between;border:1px solid rgba(251,243,231,0.1);background:{{ e.tile }}">
<div style="font-family:'IBM Plex Mono',monospace;font-size:10px;letter-spacing:1.2px;color:rgba(251,243,231,0.55)">{{ e.vintage }} · {{ e.scoreLabel }}</div>
<div>
<div style="font-family:'Fraunces',serif;font-weight:400;font-size:17px;line-height:1.15;color:#FBF3E7;letter-spacing:-0.3px">{{ e.wineName }}</div>
<div style="font-size:11.5px;color:rgba(251,243,231,0.5);margin-top:5px">{{ e.grape }}</div>
</div>
</div>
</sc-for>
</div>
</sc-if>

</div>
</sc-if>

<sc-if value="{{ isProfile }}" hint-placeholder-val="{{ true }}">
<div style="display:flex;flex-direction:column">
<div style="padding:22px 0 8px">
<div style="font-family:'Fraunces',serif;font-weight:300;font-size:25px;color:#FBF3E7;letter-spacing:-0.5px">{{ profilePossCap }} palate</div>
<div style="font-family:'IBM Plex Mono',monospace;font-size:10.5px;letter-spacing:1.2px;color:rgba(251,243,231,0.4);margin-top:8px">GRAPE × REGION, WEIGHTED BY RATING AND RECENCY</div>
</div>
<div style="display:flex;flex-direction:column">
<sc-for list="{{ tasteRows }}" as="t" hint-placeholder-count="4">
<div style="padding:15px 0;border-bottom:1px solid rgba(251,243,231,0.1);display:flex;flex-direction:column;gap:8px">
<div style="display:flex;justify-content:space-between;align-items:baseline">
<div style="font-size:13px;color:rgba(251,243,231,0.8)">{{ t.label }}</div>
<div style="font-family:'IBM Plex Mono',monospace;font-size:12px;color:#F2B85C">{{ t.score }}</div>
</div>
<div style="height:2px;background:rgba(251,243,231,0.12);position:relative"><div style="position:absolute;left:0;top:0;height:2px;background:linear-gradient(90deg,#7A2438,#E4623F,#F2B85C);width:{{ t.pct }}"></div></div>
</div>
</sc-for>
</div>
